# Source-mode build artefacts (tools/vendor.ps1). Vendored dependencies are
# reproduced from requirements-<role>.txt, and they are large - lib-server\ is
# 1170 files. They are hashed into a package, so what shipped is recorded there.
lib-client/
lib-server/

# Written by applaunch.py when an app fails to start. Diagnostic, per-machine.
launch.err.log
# Each client's own System Log. *.log above already covers client.log; the
# rolled generation does not match it, so it is named.
client.log.1
# personal scratch notes kept beside the repo, not payload - an untracked
# file here makes package.ps1 refuse to build (a dirty tree)
asset manager notes.txt

# Pre-061 build output. package.ps1 writes neither since everything
# releasable lands in dist\<version>\, but both directories still sit on
# every machine that built before that - 258 MB and 1.3 GB on this one -
# and an untracked file makes package.ps1 refuse to build (a dirty tree).
output/
packages/

# Rule 12: we ship one executable of ours and it is the installer, and it is
# built into dist\<version>\ rather than committed. CLAUDE.md's "Don't Commit
# These" has listed *.exe all along; output\ was what actually covered it, so
# removing that line left the claim enforced by nothing.
*.exe
